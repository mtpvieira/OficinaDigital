# Copie para .env antes de subir o ambiente: cp .env.example .env

# Senha do sa do SQL Server (8+ caracteres, com maiúscula, minúscula, número e símbolo).
SA_PASSWORD=Oficina@Local123

# Chave de assinatura do JWT, mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_CHAVE=troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres

# Administrador criado na primeira execução, com banco vazio.
ADMIN_EMAIL=admin@oficinadigital.local
ADMIN_SENHA=Oficina@Local123

# Development habilita o Swagger.
ASPNETCORE_ENVIRONMENT=Development
