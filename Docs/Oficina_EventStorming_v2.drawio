        <mxCell id="c_8315_8" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · CPF/CNPJ é objeto de valor: validado no formato e no dígito verificador, e único no sistema. A busca não expõe dados de outro cliente." vertex="1">
          <mxGeometry height="145" width="330" x="30" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_19" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Nome, CPF/CNPJ e ao menos um canal de contato (e-mail ou telefone) são obrigatórios. É por esse canal que toda notificação sai." vertex="1">
          <mxGeometry height="145" width="330" x="474" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_47" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" value="Ao abrir a OS, o status da OS será&amp;nbsp; RECEBIDA" vertex="1">
          <mxGeometry height="100" width="200" x="1880" y="-200" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_130" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Aprovação e reprovação são irreversíveis para a versão respondida. O cliente só enxerga e responde as OS dos seus próprios veículos." vertex="1">
          <mxGeometry height="145" width="330" x="5440" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_185" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Item adicional só pode ser executado depois da aprovação do cliente. A OS não conclui com item adicional pendente de resposta." vertex="1">
          <mxGeometry height="145" width="330" x="8010" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_222" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Valor pago = orçamento vigente + complementares aprovados. Sem pagamento registrado a OS não pode ser entregue." vertex="1">
          <mxGeometry height="145" width="330" x="9655" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_85" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Disponível = saldo − reservado. A reserva só é aceita se a quantidade ≤ disponível; o saldo nunca fica negativo." vertex="1">
          <mxGeometry height="145" width="330" x="3311" y="230" as="geometry" />
        </mxCell>
        <mxCell id="LbpRUERlNFiSzusm4pcH-22" edge="1" parent="1" source="px_2739324" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;dashed=1;dashPattern=1 2;">
