        <mxCell id="c_8670_42" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="ClienteId e VeiculoId; a OS não replica os dados cadastrais." vertex="1">
          <mxGeometry height="64" width="900" x="340" y="1175" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_43" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Atendimento → Notificação" vertex="1">
          <mxGeometry height="64" width="340" y="1239" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_45" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Publica o evento; a Notificação traduz para o provedor externo de e-mail/SMS." vertex="1">
          <mxGeometry height="64" width="900" x="340" y="1239" as="geometry" />
        </mxCell>
        <mxCell id="px_293292" value="No MVP os contextos vivem todos no mesmo monolito em camadas: a fronteira é de pacote, não de processo. O recorte abaixo é a divisão de pacotes sugerida, e por onde dá para separar depois, se precisar.&#xa;&#xa;Faturamento não entra como contexto porque o pagamento acontece fora da aplicação. O sistema só registra que houve, e esse registro é entidade do agregado OrdemDeServico. Não há integração para mapear." style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="0" y="1330" width="1240" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="07 - Linguagem Ubíqua" id="pg21736">
    <mxGraphModel dx="1122" dy="982" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_5650_1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Linguagem Ubíqua" vertex="1">
          <mxGeometry height="50" width="600" y="-110" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_2" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" value="Definição dos termos da linguagem ubíqua" vertex="1">
          <mxGeometry height="40" width="1160" y="-55" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" value="Termo (usar)" vertex="1">
          <mxGeometry height="34" width="260" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" value="Definição" vertex="1">
          <mxGeometry height="34" width="900" x="260" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Ordem de Serviço (OS)" vertex="1">
          <mxGeometry height="38" width="260" y="34" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Agregado central. Registro de tudo que acontece com um veículo de um cliente, da chegada à entrega: diagnóstico, itens de serviço, itens de peça, prazos, orçamento vigente, pagamento e status." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="34" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_9" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Status da OS" vertex="1">
          <mxGeometry height="38" width="260" y="72" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_10" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Estado atual da OS. Sete valores: Recebida, Em diagnóstico, Aguardando aprovação, Em execução, Finalizada, Entregue e Cancelada. Muda sempre por política automática, nunca por comando. Os seis primeiros são o caminho de sucesso do enunciado; Cancelada é a saída de exceção." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="72" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Diagnóstico" vertex="1">
          <mxGeometry height="38" width="260" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Etapa em que o mecânico levanta os serviços e as peças necessárias e informa o prazo estimado." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Orçamento" vertex="1">
          <mxGeometry height="38" width="260" y="148" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Agregado com o valor proposto ao cliente para uma OS." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="148" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Versão do orçamento" vertex="1">
          <mxGeometry height="38" width="260" y="186" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Cada geração ou alteração cria uma nova versão. A resposta do cliente vale para a versão respondida." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="186" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Orçamento complementar" vertex="1">
          <mxGeometry height="38" width="260" y="224" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Orçamento adicional gerado quando surge problema durante a execução. Precisa de aprovação própria do cliente." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="224" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_24" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Item de serviço" vertex="1">
          <mxGeometry height="38" width="260" y="262" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_25" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Linha da OS que referencia um serviço do catálogo, com preço congelado na data do registro." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="262" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_27" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Item de peça" vertex="1">
          <mxGeometry height="38" width="260" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_28" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Linha da OS que referencia uma peça do catálogo, com quantidade e preço congelado." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_30" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Serviço" vertex="1">
          <mxGeometry height="38" width="260" y="338" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_31" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Entrada do catálogo: o que a oficina sabe fazer, com preço vigente e tempo padrão de execução." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="338" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_33" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Peça" vertex="1">
          <mxGeometry height="38" width="260" y="376" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_34" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Entrada do catálogo de itens físicos (peças e insumos), com controle de estoque, unidade e preço vigente." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="376" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_36" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Saldo de estoque" vertex="1">
          <mxGeometry height="38" width="260" y="414" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_37" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Quantidade física de uma peça no estoque." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="414" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_39" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Reservado" vertex="1">
          <mxGeometry height="38" width="260" y="452" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_40" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Parte do saldo comprometida com OS que ainda não iniciaram a execução." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="452" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_42" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Disponível" vertex="1">
          <mxGeometry height="38" width="260" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_43" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Saldo menos Reservado. É o que pode ser reservado para uma nova OS." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_45" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Reserva" vertex="1">
          <mxGeometry height="38" width="260" y="528" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_46" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Ato de comprometer quantidade de uma peça para uma OS, no momento em que o item é registrado. Não altera o saldo, só reduz o Disponível." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="528" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_48" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Subtração" vertex="1">
          <mxGeometry height="38" width="260" y="566" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_49" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Saída efetiva da peça do estoque, no início da execução do serviço. Reduz saldo e reservado juntos, na mesma transação." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="566" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_51" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Liberação de reserva" vertex="1">
          <mxGeometry height="38" width="260" y="604" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_52" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Devolver ao Disponível uma reserva de OS reprovada, expirada ou cancelada." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="604" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_54" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Peças da OS reservadas / Peça reservada" vertex="1">
          <mxGeometry height="38" width="260" y="642" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_55" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="O contexto Estoque publica um evento por peça (Peça reservada, Peça subtraída do estoque, Reserva de peça liberada). A Ordem de Serviço enxerga o conjunto e publica o agregado correspondente (Peças da OS reservadas, Peças da OS subtraídas do estoque, Reservas da OS liberadas)." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="642" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_57" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Prazo estimado" vertex="1">
          <mxGeometry height="38" width="260" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_58" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Previsão de conclusão informada pelo mecânico ao fechar o diagnóstico." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_60" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Duração real" vertex="1">
          <mxGeometry height="38" width="260" y="718" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_61" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Tempo entre Serviço iniciado e Serviço concluído, descontado o tempo aguardando aprovação de complementar. Base do tempo médio de execução." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="718" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_63" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Cliente" vertex="1">
          <mxGeometry height="38" width="260" y="756" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_64" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Pessoa física ou jurídica dona do veículo, identificada por CPF/CNPJ." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="756" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_66" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Veículo" vertex="1">
          <mxGeometry height="38" width="260" y="794" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_67" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Carro atendido, identificado por placa e vinculado a um Cliente." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="794" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_69" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Atendente" vertex="1">
          <mxGeometry height="38" width="260" y="832" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_70" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Ator interno que abre a OS, cuida do orçamento, do pagamento e da entrega." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="832" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_72" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Mecânico" vertex="1">
          <mxGeometry height="38" width="260" y="870" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_73" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Ator interno que faz o diagnóstico e executa o serviço." vertex="1">
          <mxGeometry height="38" width="900" x="260" y="870" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="08 - Decisões de Modelagem e Premissas" id="pg45734">
    <mxGraphModel dx="1122" dy="582" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_5093_26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Decisões de modelagem e premissas assumidas pelo grupo" vertex="1">
          <mxGeometry height="50" width="1000" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_27" parent="1" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" value="Pergunta" vertex="1">
          <mxGeometry height="34" width="420" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_29" parent="1" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" value="Decisão" vertex="1">
          <mxGeometry height="34" width="900" x="420" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_30" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Qual a forma de contato com o cliente?" vertex="1">
          <mxGeometry height="86" width="420" y="494" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_32" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="E-mail e SMS, tirados do cadastro do cliente, onde ao menos um canal é obrigatório. O envio fica no contexto Notificação." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="494" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_33" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Terá fluxo de compra de peça?" vertex="1">
          <mxGeometry height="86" width="420" y="580" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_35" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Não no MVP. O sistema emite alerta de estoque mínimo e registra a entrada (recebimento) das peças. Pedido de compra e cadastro de fornecedor ficam fora do escopo." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="580" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_36" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Quais são os dados da OS?" vertex="1">
          <mxGeometry height="86" width="420" y="666" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_38" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Cliente, veículo, status, itens de serviço, itens de peça, prazo estimado, duração real, orçamento vigente e pagamento. Detalhado no agregado OrdemDeServico (página 05)." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="666" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_39" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="&quot;Atendimento&quot; e &quot;OS&quot; são a mesma coisa?" vertex="1">
          <mxGeometry height="86" width="420" y="752" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_41" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="São a mesma coisa. O conceito &quot;atendimento&quot; foi eliminado; a Ordem de Serviço é o agregado raiz desde a abertura, como no enunciado. &quot;Atendimento&quot; deixou de ser usado em todo o board." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="752" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_42" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Em que momento a peça sai do estoque?" vertex="1">
          <mxGeometry height="86" width="420" y="838" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_44" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Reserva quando a peça entra na OS, subtração quando o serviço começa, liberação quando o orçamento é reprovado, expira ou a OS é cancelada. Assim não se consome estoque de OS que o cliente vai reprovar." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="838" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_45" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Gerar orçamento é automático ou manual?" vertex="1">
          <mxGeometry height="86" width="420" y="924" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_47" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Automático: política dispara ao finalizar o diagnóstico. O atendente pode alterar depois, o que cria nova versão e reenvia ao cliente." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="924" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_48" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="A OS é gerada antes ou depois da aprovação?" vertex="1">
          <mxGeometry height="86" width="420" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_50" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="A OS existe desde a abertura. O orçamento é um agregado separado, referenciado por ID, com ciclo de vida e versionamento próprios. Sumiram os passos &quot;Gerar OS&quot; e &quot;Notificar atendente&quot;." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_51" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Como o cliente autoriza reparo adicional?" vertex="1">
          <mxGeometry height="86" width="420" y="1096" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_53" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Pelo app: orçamento complementar é gerado por política ao registrar itens adicionais, enviado ao cliente e respondido por ele. Sem aprovação, os itens adicionais não são executados e a OS não conclui." vertex="1">
          <mxGeometry height="86" width="900" x="420" y="1096" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Qual o prazo de validade do orçamento?" vertex="1">
          <mxGeometry height="76" width="420" y="1182" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="15 dias" vertex="1">
          <mxGeometry height="76" width="900" x="420" y="1182" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Pode existir mais de uma OS aberta para o mesmo veículo ao mesmo tempo?" vertex="1">
          <mxGeometry height="76" width="420" y="1258" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Não. Em caso de necessidade, a OS pode ser alterada." vertex="1">
          <mxGeometry height="76" width="900" x="420" y="1258" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-10" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="A oficina cobra o diagnóstico quando o cliente reprova o orçamento?" vertex="1">
          <mxGeometry height="76" width="420" y="1334" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Não." vertex="1">
          <mxGeometry height="76" width="900" x="420" y="1334" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="OS cancelada e OS encerrada sem execução reaproveitam FINALIZADA ou exigem um status fora dos 6 do enunciado?" vertex="1">
          <mxGeometry height="76" width="420" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="ZMJNG_BR-J7jYlXc4AB5-15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="Criamos um novo status de Cancelado." vertex="1">
          <mxGeometry height="76" width="900" x="420" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="px_233879" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f4f4f4;spacingLeft=8;spacingTop=6;fontSize=11;verticalAlign=middle;" value="O sistema registra recebimentos parciais na mesma OS?" vertex="1">
          <mxGeometry height="76" width="420" y="1486" as="geometry" />
        </mxCell>
        <mxCell id="px_241634" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f4f4f4;spacingLeft=8;spacingTop=6;fontSize=11;verticalAlign=middle;" value="Não. Um registro de pagamento por OS, no valor total. O pagamento acontece fora da aplicação, na maquininha, no PIX ou em espécie, e o sistema só anota que aconteceu, como condição para entregar o carro. Parcelamento é problema da adquirente." vertex="1">
          <mxGeometry height="76" width="900" x="420" y="1486" as="geometry" />
        </mxCell>
        <mxCell id="px_246127" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" value="A oficina do enunciado não existe, então não havia especialista de domínio para responder nada. O grupo decidiu. Cada linha abaixo traz a decisão e o motivo dela. É por isso que não sobrou hotspot aberto no board." vertex="1">
          <mxGeometry height="60" width="1320" y="330" as="geometry" />
        </mxCell>
        <mxCell id="px_260981" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Fora do escopo do MVP, por decisão consciente" vertex="1">
          <mxGeometry height="45" width="900" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="px_265068" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="Garantia e retrabalho pós-entrega" vertex="1">
          <mxGeometry height="62" width="420" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="px_274744" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="Uma OS entregue é terminal. Retorno do mesmo defeito abre OS nova, sem vínculo formal de garantia." vertex="1">
          <mxGeometry height="62" width="900" x="420" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="px_284143" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="Veículo abandonado na oficina" vertex="1">
          <mxGeometry height="62" width="420" y="1717" as="geometry" />
        </mxCell>
        <mxCell id="px_294429" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="Não há política de prazo, cobrança de estadia ou destinação. A OS fica em CANCELADA ou ENTREGUE conforme o desfecho." vertex="1">
          <mxGeometry height="62" width="900" x="420" y="1717" as="geometry" />
        </mxCell>
        <mxCell id="px_299198" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="Conciliação financeira e nota fiscal" vertex="1">
          <mxGeometry height="62" width="420" y="1779" as="geometry" />
        </mxCell>
        <mxCell id="px_310801" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="O sistema registra o recebimento, não emite documento fiscal nem concilia com a adquirente." vertex="1">
          <mxGeometry height="62" width="900" x="420" y="1779" as="geometry" />
        </mxCell>
        <mxCell id="px_317306" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="Pedido de compra e cadastro de fornecedor" vertex="1">
          <mxGeometry height="62" width="420" y="1841" as="geometry" />
        </mxCell>
        <mxCell id="px_318639" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;verticalAlign=middle;" value="O estoque emite alerta de mínimo e registra a entrada da peça. A compra em si acontece fora do sistema." vertex="1">
          <mxGeometry height="62" width="900" x="420" y="1841" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="09 - Rastreabilidade dos requisitos" id="pg60410">
