        <mxCell id="c_6778_33" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="—" vertex="1">
