        <mxCell id="c_8315_337" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#36393d;fillColor=#eeeeee;align=center;verticalAlign=middle;rounded=0;fontSize=18;fontStyle=1;" value="Alteração, reprovação, expiração e cancelamento" vertex="1">
          <mxGeometry height="60" width="2060" x="-30" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="c_8315_338" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" value="Como ler a linha principal: ela é o caminho feliz. Os eventos laranja da faixa de baixo são os desfechos alternativos daquele mesmo passo. Cadastrar Cliente e Cadastrar Veículo só acontecem quando ocorrem os eventos alternativos Cliente não encontrado e Veículo não encontrado; se o cliente e o veículo já existem, o fluxo segue direto para Abrir Ordem de Serviço. Falta de peça identificada abre o fluxo da página 03 e volta a este ponto quando a peça entra no estoque." vertex="1">
          <mxGeometry height="80" width="1900" y="1090" as="geometry" />
        </mxCell>
