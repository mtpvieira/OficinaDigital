        <mxCell id="a5_1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Design Level: agregados, entidades, objetos de valor e invariantes" vertex="1">
          <mxGeometry height="46" width="1100" y="-150" as="geometry" />
        </mxCell>
        <mxCell id="a5_2" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" value="Referência entre agregados é sempre por ID, nunca por objeto. Uma transação altera um agregado só; o que precisa chegar nos outros vai por política, com consistência eventual. Objeto de valor é imutável e comparado por conteúdo. Preço de serviço e de peça congela no momento em que entra na OS ou no orçamento." vertex="1">
          <mxGeometry height="66" width="1900" y="-95" as="geometry" />
        </mxCell>
        <mxCell id="a5_3" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#36393d;fillColor=#f5e60a;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=1;strokeWidth=2;" value="Cliente" vertex="1">
          <mxGeometry height="46" width="470" as="geometry" />
