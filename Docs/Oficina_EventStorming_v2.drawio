        <mxCell id="c_5729_5" value="Pág. 02 · Identificar Cliente por CPF/CNPJ + REGRA de validação e unicidade; agregado Cliente (pág. 05)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
