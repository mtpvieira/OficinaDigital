          <mxGeometry x="0" y="34" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_7" value="Agregado central. Registro de tudo que acontece com um veículo de um cliente, da chegada à entrega: diagnóstico, itens de serviço, itens de peça, prazos, orçamento vigente, pagamento e status." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="260" y="34" width="900" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_8" value="atendimento, demanda, chamado, pedido, registro do atendimento" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="34" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_9" value="Status da OS" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="72" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c_5650_10" value="Estado atual da OS. Exatamente seis: Recebida, Em diagnóstico, Aguardando aprovação, Em execução, Finalizada, Entregue. Muda sempre por política automática." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
