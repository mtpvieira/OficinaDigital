        <mxCell id="c_1803_89" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Segurança e autorização" vertex="1">
