        <mxCell id="c_8315_349" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=default;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;fillColor=default;" value="Ator" vertex="1">
