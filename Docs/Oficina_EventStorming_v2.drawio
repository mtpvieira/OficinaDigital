        <mxCell id="c_6778_34" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" value="09" vertex="1">
