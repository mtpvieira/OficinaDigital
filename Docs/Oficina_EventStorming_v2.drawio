        <mxCell id="px_713227" value="Painel de tempo médio de execução&#xa;por tipo de serviço" style="whiteSpace=wrap;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=green;" vertex="1" parent="1">
