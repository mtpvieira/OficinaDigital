        <mxCell id="a5_95" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Máquina de estados da Ordem de Serviço" vertex="1">
