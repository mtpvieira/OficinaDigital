        </mxCell>
        <mxCell id="c_6778_35" value="Rastreabilidade: requisito do enunciado → onde está no board" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="110" y="640" width="800" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_6778_36" value="—" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
