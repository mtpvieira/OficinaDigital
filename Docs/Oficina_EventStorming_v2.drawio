        </mxCell>
        <mxCell id="px_746676" value="REGRA · Tempo médio de execução = média das durações reais das OS que chegaram a FINALIZADA no período, por tipo de serviço, comparada ao tempo padrão do catálogo. OS cancelada fica de fora: nunca executou." style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
