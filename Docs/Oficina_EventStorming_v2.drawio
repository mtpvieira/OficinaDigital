          <mxGeometry x="1340" y="-16" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_10" value="Pode existir mais de uma OS aberta para o mesmo veículo ao mesmo tempo?" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="60" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_11" value="Gerente da oficina" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_12" value="É invariante do agregado OrdemDeServico. Muda a validação na abertura da OS." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="620" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_13" value="Antes da sprint 1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="1340" y="60" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_14" value="O MVP aceita pagamento parcial ou parcelado?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="136" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_15" value="Financeiro" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="520" y="136" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_16" value="Se sim, Pagamento vira agregado próprio e a regra &quot;não entrega sem pagamento&quot; muda para &quot;não entrega sem quitação&quot;." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="720" y="136" width="620" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_17" value="Antes da sprint 3" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="1340" y="136" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_18" value="A oficina cobra o diagnóstico quando o cliente reprova o orçamento?" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="212" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_19" value="Gerente da oficina" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="520" y="212" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_20" value="Cria um item de serviço obrigatório e um fluxo de cobrança no encerramento sem execução." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="720" y="212" width="620" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_21" value="Antes da sprint 3" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="1340" y="212" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_22" value="OS encerrada sem execução e OS cancelada reaproveitam FINALIZADA ou exigem um status fora dos 6 do enunciado?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="288" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_23" value="Time técnico + professor" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="520" y="288" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_24" value="O enunciado fixa 6 status. Um sétimo status precisa ser justificado na documentação." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="720" y="288" width="620" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_25" value="Antes da sprint 1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="1340" y="288" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_26" value="Decisões tomadas — hotspots da versão 1 que foram resolvidos" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="0" y="400" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_27" value="Pergunta" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" vertex="1" parent="1">
          <mxGeometry x="0" y="460" width="420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_28" value="Origem" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" vertex="1" parent="1">
          <mxGeometry x="420" y="460" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_29" value="Decisão" style="whiteSpace=wrap;html=1;fillColor=#36393d;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;strokeColor=#36393d;" vertex="1" parent="1">
          <mxGeometry x="760" y="460" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_30" value="Qual a forma de contato com o cliente?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="494" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_31" value="17 post-its na v1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="494" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_32" value="E-mail e SMS, tirados do cadastro do cliente. Ao menos um canal é obrigatório no cadastro. O envio fica no contexto genérico Notificação, atrás de uma camada anticorrupção." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="494" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_33" value="Terá fluxo de compra de peça?" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="580" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_34" value="4 post-its na v1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_35" value="Não no MVP. O sistema emite alerta de estoque mínimo e registra a entrada (recebimento) das peças. Pedido de compra e cadastro de fornecedor ficam fora do escopo." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="580" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_36" value="Quais são os dados da OS?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="666" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_37" value="3 post-its na v1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="666" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_38" value="Cliente, veículo, status, itens de serviço, itens de peça, prazo estimado, duração real, orçamento vigente e pagamento. Detalhado no agregado OrdemDeServico (página 05)." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="666" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_39" value="&quot;Atendimento&quot; e &quot;OS&quot; são a mesma coisa?" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="752" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_40" value="Divergência com o enunciado" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="752" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_41" value="São a mesma coisa. O conceito &quot;atendimento&quot; foi eliminado; a Ordem de Serviço é o agregado raiz desde a abertura, como no enunciado. &quot;Atendimento&quot; entrou na lista de termos banidos." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="752" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_42" value="Quando dar baixa no estoque?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="838" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_43" value="Política da v1 dava baixa no cadastro da peça" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="838" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_44" value="Reserva quando a peça é registrada na OS, baixa efetiva quando o serviço inicia, liberação quando o orçamento é reprovado/expira ou a OS é cancelada. Evita consumir estoque de OS que o cliente reprova." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="838" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_45" value="Gerar orçamento é automático ou manual?" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="924" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_46" value="A v1 tinha a política e o comando manual ao mesmo tempo" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="924" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_47" value="Automático: política dispara ao finalizar o diagnóstico. O atendente pode alterar depois, o que cria nova versão e reenvia ao cliente." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="924" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_48" value="A OS é gerada antes ou depois da aprovação?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="1010" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_49" value="Na v1 a OS era gerada depois do diagnóstico e antes do envio do orçamento" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="1010" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_50" value="A OS existe desde a abertura. O orçamento é um agregado separado, referenciado por ID, com ciclo de vida e versionamento próprios. Sumiram os passos &quot;Gerar OS&quot; e &quot;Notificar atendente&quot;." style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="1010" width="900" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_51" value="Como o cliente autoriza reparo adicional?" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="1096" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_52" value="Requisito do enunciado sem cobertura na v1" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="420" y="1096" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c_5093_53" value="Pelo app: orçamento complementar é gerado por política ao registrar itens adicionais, enviado ao cliente e respondido por ele. Sem aprovação, os itens adicionais não são executados e a OS não conclui." style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="760" y="1096" width="900" height="86" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="09 - Rastreabilidade dos requisitos" id="pg60410">
