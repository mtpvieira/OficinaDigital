          <mxGeometry height="65" width="470" y="276" as="geometry" />
        </mxCell>
        <mxCell id="a5_10" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#36393d;fillColor=#fffbc0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=1;spacingLeft=8;" value="INVARIANTES" vertex="1">
