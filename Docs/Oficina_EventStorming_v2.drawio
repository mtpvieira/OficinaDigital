        <mxCell id="c_5729_6" value="Cadastro de veículo (placa, marca, modelo, ano)" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="38" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_7" value="Pág. 02 · Cadastrar Veículo + REGRA de placa; agregado Veiculo (pág. 05)" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="560" y="38" width="1100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_8" value="Inclusão dos serviços solicitados" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="92" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_9" value="Pág. 02 · Registrar serviços necessários → Serviços da OS registrados" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="560" y="92" width="1100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_10" value="Inclusão de peças e insumos" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="146" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_11" value="Pág. 02 · Registrar peças necessárias → Peças da OS registradas → Peças reservadas" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="560" y="146" width="1100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_12" value="Orçamento gerado automaticamente com base nos serviços e peças" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="200" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_13" value="Pág. 02 · política &quot;Ao finalizar o diagnóstico → gerar o orçamento automaticamente&quot; → Orçamento gerado + REGRA de cálculo" style="whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="1100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_14" value="Envio do orçamento ao cliente para aprovação" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="0" y="254" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_5729_15" value="Pág. 02 · Enviar Orçamento ao cliente → Orçamento enviado; política de notificação por e-mail/SMS" style="whiteSpace=wrap;html=1;fillColor=#f4f4f4;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=2;strokeColor=#b0b0b0;" vertex="1" parent="1">
          <mxGeometry x="560" y="254" width="1100" height="54" as="geometry" />
        </mxCell>
