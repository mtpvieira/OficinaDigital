        <mxCell id="c_5650_2" value="Um conceito, um termo. O termo da coluna 1 é o que vale em conversa, no board, no código e na API." style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
