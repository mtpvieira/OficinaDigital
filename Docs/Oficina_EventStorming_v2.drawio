        <mxCell id="c_1803_90" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Todo comando com borda tracejada amarela exige JWT válido com perfil interno (Atendente ou Mecânico). São as APIs administrativas." vertex="1">
          <mxGeometry height="74" width="1300" x="-15" y="638" as="geometry" />
        </mxCell>
        <mxCell id="c_1803_91" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Os comandos do Cliente (Responder Orçamento, Responder Orçamento complementar, Consultar andamento da OS) exigem token do cliente, com escopo restrito às OS dos seus próprios veículos." vertex="1">
          <mxGeometry height="74" width="1300" x="-15" y="720" as="geometry" />
        </mxCell>
        <mxCell id="c_1803_92" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · CPF/CNPJ e placa são validados duas vezes: no formato e dígito verificador ao entrar na borda, e na unicidade dentro do agregado." vertex="1">
          <mxGeometry height="74" width="1300" x="-15" y="802" as="geometry" />
        </mxCell>
        <mxCell id="c_1803_93" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;spacingLeft=6;spacingTop=4;" value="REGRA · Nenhum endpoint público expõe dados de cliente diferente do dono do token. A consulta de andamento devolve apenas status, itens e datas da OS consultada." vertex="1">
          <mxGeometry height="74" width="1300" x="-15" y="884" as="geometry" />
        </mxCell>
        <mxCell id="DSfl0ZXIv6IpjXW-GWAD-2" edge="1" parent="1" source="c_1803_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;dashed=1;endArrow=none;strokeColor=#b0b0b0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="c_1803_61" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3468" y="85" as="sourcePoint" />
            <mxPoint x="3573" y="50" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="05 - Design Level: Agregados e Invariantes" id="pg44883">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_8480_1" value="Agregados, entidades, objetos de valor e invariantes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="0" y="-110" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_2" value="Regra transversal: referência entre agregados é sempre por identidade (ID), nunca por objeto. Uma transação altera um único agregado; o resto acontece por política (consistência eventual)." style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="0" y="-50" width="1500" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_3" value="Cliente  (raiz)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="0" y="40" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_4" value="Entidade raiz: Cliente Objetos de valor: CpfCnpj, Email, Telefone, Endereco  INVARIANTES • CpfCnpj válido (dígito verificador) e único no sistema • Ao menos um canal de contato preenchido • Cliente com OS em aberto não pode ser inativado  EVENTOS PUBLICADOS Cliente cadastrado · Dados do cliente alterados · Cliente inativado" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="0" y="90" width="400" height="482" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_5" value="Veiculo  (raiz)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_6" value="Entidade raiz: Veiculo Objetos de valor: Placa, Marca, Modelo, AnoFabricacao  INVARIANTES • Placa válida (padrão antigo ou Mercosul), única e imutável • Todo veículo pertence a exatamente um Cliente (por ID) • Ano de fabricação não pode ser futuro  EVENTOS PUBLICADOS Veículo cadastrado · Dados do veículo alterados · Veículo transferido de proprietário" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="400" height="482" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_7" value="OrdemDeServico  (raiz)  — agregado central" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="40" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_8" value="Entidade raiz: OrdemDeServico Entidades internas: ItemDeServico, ItemDePeca, Pagamento Objetos de valor: StatusOS, PrazoEstimado, DuracaoReal, Dinheiro Referências por ID: ClienteId, VeiculoId, OrcamentoVigenteId  INVARIANTES • Status segue a máquina de estados ao lado; transição inválida é rejeitada • Só entra em EM EXECUÇÃO com orçamento aprovado e vigente • Não vai para ENTREGUE sem Pagamento registrado • Não conclui com item adicional pendente de resposta do cliente • Total da OS = Σ ItemDeServico + Σ ItemDePeca (preços congelados) • Só pode ser cancelada antes de Serviço concluído  EVENTOS PUBLICADOS OS aberta · Diagnóstico iniciado · Serviços da OS registrados · Peças da OS registradas · Prazo estimado registrado · Diagnóstico finalizado · Serviço iniciado · Problema adicional registrado · Serviço concluído · Duração real registrada · Pagamento registrado · Veículo entregue · OS cancelada · OS encerrada sem execução" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="400" height="482" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_9" value="Orcamento  (raiz)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1320" y="40" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_10" value="Entidade raiz: Orcamento Entidades internas: VersaoOrcamento, ItemOrcado Objetos de valor: Dinheiro, ValidadeEmDias, RespostaCliente Referência por ID: OrdemDeServicoId  INVARIANTES • Exatamente uma versão vigente por OS a cada momento • Aprovação e reprovação são irreversíveis para a versão respondida • Alterar orçamento cria nova versão; a anterior vira histórico • Versão vencida não pode ser aprovada • Orçamento complementar referencia a versão principal aprovada  EVENTOS PUBLICADOS Orçamento gerado · Orçamento alterado · Orçamento enviado ao cliente · Orçamento aprovado · Orçamento reprovado · Orçamento expirado · Orçamento complementar aprovado/reprovado" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="90" width="400" height="482" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_11" value="ItemEstoque  (raiz)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="0" y="632" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_12" value="Entidade raiz: ItemEstoque Objetos de valor: Quantidade, EstoqueMinimo Referência por ID: PecaId  INVARIANTES • Saldo ≥ 0 sempre • Reservado ≤ Saldo • Disponível = Saldo − Reservado • Reserva só é aceita se quantidade ≤ Disponível • Baixa consome reserva: Saldo e Reservado caem na mesma transação • Ajuste de inventário exige motivo e é auditado  EVENTOS PUBLICADOS Entrada de peças registrada · Peça reservada · Reserva de peça liberada · Peça baixada do estoque · Peça devolvida ao estoque · Saldo ajustado por inventário · Alerta de estoque mínimo emitido" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="0" y="682" width="400" height="346" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_13" value="Peca  (raiz, catálogo)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="632" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_14" value="Entidade raiz: Peca Objetos de valor: Sku, UnidadeDeMedida, PrecoVigente  INVARIANTES • SKU único • Preço tem vigência por data • Peça inativa não entra em novos orçamentos  EVENTOS PUBLICADOS Peça cadastrada · Preço da peça alterado · Peça inativada" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="682" width="400" height="346" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_15" value="Servico  (raiz, catálogo)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="632" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_16" value="Entidade raiz: Servico Objetos de valor: PrecoVigente, TempoPadraoExecucao  INVARIANTES • Nome único • Preço e tempo padrão obrigatórios • Serviço inativo não entra em novos diagnósticos  EVENTOS PUBLICADOS Serviço cadastrado no catálogo · Preço do serviço alterado · Serviço inativado" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="682" width="400" height="346" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_17" value="Notificacao  (raiz, subdomínio genérico)" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1320" y="632" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_18" value="Entidade raiz: Notificacao Objetos de valor: Canal (EMAIL | SMS), Destinatario, Conteudo, StatusEnvio  INVARIANTES • Só envia para um canal cadastrado do cliente • Reenvio é idempotente por (OS, evento, canal)  EVENTOS PUBLICADOS Cliente notificado de veículo pronto · Cliente notificado do orçamento  OBS: acessa o provedor externo de e-mail/SMS por uma camada anticorrupção (ACL)." style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="682" width="400" height="346" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_19" value="Máquina de estados da Ordem de Serviço (os 6 status do enunciado)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="0" y="1118" width="900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_20" value="RECEBIDA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="0" y="1178" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_21" value="gatilho automático: OS aberta" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="0" y="1268" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_22" value="EM DIAGNÓSTICO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="1178" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_23" value="gatilho automático: Diagnóstico iniciado" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="1268" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_8480_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;strokeColor=#36393d;" edge="1" parent="1" source="c_8480_20" target="c_8480_22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_25" value="AGUARDANDO APROVAÇÃO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="1178" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_26" value="gatilho automático: Orçamento enviado ao cliente" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="1268" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_8480_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;strokeColor=#36393d;" edge="1" parent="1" source="c_8480_22" target="c_8480_25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_28" value="EM EXECUÇÃO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="1178" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_29" value="gatilho automático: Serviço iniciado" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="900" y="1268" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_8480_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;strokeColor=#36393d;" edge="1" parent="1" source="c_8480_25" target="c_8480_28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_31" value="FINALIZADA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1178" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_32" value="gatilho automático: Serviço concluído" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1268" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_8480_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;strokeColor=#36393d;" edge="1" parent="1" source="c_8480_28" target="c_8480_31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_34" value="ENTREGUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1178" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_35" value="gatilho automático: Veículo entregue" style="whiteSpace=wrap;html=1;strokeColor=#3700CC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fillColor=#6a00ff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1268" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_8480_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;strokeColor=#36393d;" edge="1" parent="1" source="c_8480_31" target="c_8480_34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8480_37" value="Saídas de exceção: de RECEBIDA, EM DIAGNÓSTICO, AGUARDANDO APROVAÇÃO ou EM EXECUÇÃO a OS pode ir para OS cancelada; de AGUARDANDO APROVAÇÃO pode ir para OS encerrada sem execução (orçamento reprovado ou expirado). Ver hotspot na página 08 sobre qual status representa esses dois desfechos." style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="0" y="1368" width="1800" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="06 - Bounded Contexts e Mapa de Contextos" id="pg88787">
    <mxGraphModel dx="2951" dy="1787" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_8670_1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1;align=left;" value="Bounded Contexts e subdomínios" vertex="1">
          <mxGeometry height="50" width="900" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_2" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;" value="No MVP todos os contextos vivem no mesmo monolito em camadas — a fronteira é de módulo/pacote, não de processo. O recorte abaixo é a estrutura de contextos delimitados." vertex="1">
          <mxGeometry height="46" width="1600" y="-115" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=3;dashed=1;align=center;verticalAlign=top;fontSize=15;fontStyle=1;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="Atendimento / Oficina NÚCLEO (Core)" vertex="1">
          <mxGeometry height="380" width="460" x="-25" y="-15" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_4" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;" value="AGREGADOS OrdemDeServico ItemDeServico · ItemDePeca · Pagamento" vertex="1">
          <mxGeometry height="100" width="380" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_5" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#666666;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;spacingLeft=8;spacingTop=6;fontSize=10;" value="EVENTOS PUBLICADOS OS aberta · Diagnóstico iniciado/finalizado · Serviço iniciado/concluído · Veículo entregue · OS cancelada" vertex="1">
          <mxGeometry height="120" width="380" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=3;dashed=1;align=center;verticalAlign=top;fontSize=15;fontStyle=1;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="Orçamento NÚCLEO (Core)" vertex="1">
          <mxGeometry height="380" width="460" x="446" y="-15" as="geometry" />
        </mxCell>
        <mxCell id="c_8670_7" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#ffff88;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;" value="AGREGADOS Orcamento VersaoOrcamento · ItemOrcado" vertex="1">
