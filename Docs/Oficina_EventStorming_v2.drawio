        <mxCell id="a5_21" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#36393d;fillColor=#fffbc0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=1;spacingLeft=8;" value="INVARIANTES" vertex="1">
